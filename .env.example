# =====================================================================
# Vibe Invite — environment variables
# Copy this file to .env and fill in the values.
# Only fill in the section that matches your proxy choice.
# =====================================================================

# --- Django (required for all setups) ---
# Generate a SECRET_KEY with:
#   python3 -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-me-with-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=events.example.com
CSRF_TRUSTED_ORIGINS=https://events.example.com
SITE_URL=https://events.example.com
ADMIN_EMAIL=admin@events.example.com
ADMIN_URL=admin/         # Change to a secret path in production, e.g. my-secret-admin-path/

# --- Database (required for all setups) ---
DB_ENGINE=postgresql
DB_NAME=vibe_invite
DB_USER=vibe_invite
DB_PASSWORD=replace-me
DB_HOST=vibe_invite_db
DB_PORT=5432

# --- Email / SMTP (required for all setups) ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your@email.com
EMAIL_HOST_PASSWORD=your-smtp-password
DEFAULT_FROM_EMAIL=invitations@events.example.com

# =============================================================
# Fill in ONE of the sections below depending on your proxy:
# =============================================================

# --- Caddy (make start) ---
DOMAIN=events.example.com
ACME_EMAIL=your@email.com

# --- Traefik (make start-traefik) ---
# DOMAIN=events.example.com
# TRAEFIK_NETWORK=traefik          # Docker network Traefik listens on
# TRAEFIK_CERTRESOLVER=letsencrypt # Name of your Traefik ACME resolver
# TRAEFIK_ENTRYPOINT=websecure     # Usually "websecure" (port 443)

# --- Pangolin / newt (make start-pangolin) ---
# Find these values in your Pangolin dashboard → Sites → (your site) → Newt Agent
# PANGOLIN_ENDPOINT=https://pangolin.example.com
# PANGOLIN_SITE_ID=your-site-id
# PANGOLIN_SITE_SECRET=your-site-secret

# --- Nginx Proxy Manager (make start-npm) ---
# No extra variables needed — NPM is configured through its web UI.

# =============================================================
# Cloud media storage (optional — leave unset for local storage)
# Supports AWS S3, Cloudflare R2, MinIO, and any S3-compatible API.
# =============================================================
# USE_S3=True
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_STORAGE_BUCKET_NAME=your-bucket-name
#
# # AWS region (required for standard S3, optional for R2/MinIO)
# AWS_S3_REGION_NAME=eu-west-1
#
# # Custom endpoint — required for Cloudflare R2 and MinIO, omit for AWS S3
# # Cloudflare R2: https://<account-id>.r2.cloudflarestorage.com
# # MinIO:         http://minio:9000
# AWS_S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
#
# # Optional CDN / public domain in front of the bucket
# AWS_S3_CUSTOM_DOMAIN=media.events.example.com
#
# # Sub-folder inside the bucket for media files (default: media)
# AWS_MEDIA_LOCATION=media
#
# # ACL: "private" (default, presigned URLs) or "public-read" (direct URLs, no signing)
# AWS_DEFAULT_ACL=private
# AWS_QUERYSTRING_AUTH=True
